FROM nvidia/cuda:12.4.1-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-dev \
    python3-pip \
    python3-venv \
    git \
    build-essential \
    pkg-config \
    libopus-dev \
    ca-certificates \
    curl \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements-runpod.txt /app/requirements-runpod.txt
COPY presonaplex.py /app/presonaplex.py
COPY runpod_start.sh /app/runpod_start.sh
COPY runpod_serverless.py /app/runpod_serverless.py

RUN chmod +x /app/runpod_start.sh

RUN python3 -m pip install --no-cache-dir --upgrade pip uv
# Use the pod-specific requirements (no livekit-agents/av/numpy — those live on the agent side)
RUN uv pip install --system -r /app/requirements-runpod.txt
RUN uv pip install --system "git+https://github.com/NVIDIA/personaplex.git#subdirectory=moshi"
RUN uv pip install --system --upgrade --pre --index-url https://download.pytorch.org/whl/nightly/cu128 torch torchvision torchaudio

EXPOSE 8000 8998

CMD ["/app/runpod_start.sh"]
